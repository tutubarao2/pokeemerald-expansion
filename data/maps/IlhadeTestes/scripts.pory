mapscripts IlhadeTestes_MapScripts {}

script PortaTrancada {
    lock
    msgbox (format("Esta porta está trancada. Se você viu isso, o teste é um sucesso!"))
    release
    end
}

// Apesar deste script estar neste mapa em específico, ele deveria ser um Commom_eventSscript
// que seria chamado sempre que o jogador pisasse em um save point. Deixei aqui só para testar
script SavePoint {
    lock
    hidefollower (0)
    fadescreencustom (FADE_FROM_CUSTOM, 3, 13, 0, 31) // modo, velocidade (menor é + rápido), r, g, b
    special (HealPlayerParty)
    msgbox ("Você e seus pokémon se sentem
            revigorados.")
    call (Common_EventScript_SaveGame)
    release
    end
}

script Anim {
    lock
    applymovement (LOCALID_TRIANGLE, moves(
        init_affine_anim,
        walk_down_affine, // usado por groudon e kyogre quando encontrados nas cavernas
        walk_fast_up,
        levitate
    ))
    waitmovement (0)
    msgbox("Olá, humano!")
    applymovement(LOCALID_TRIANGLE, moves(
        clear_affine_anim,
        stop_levitate
    ))
    waitmovement (0)
    release
    end
}
