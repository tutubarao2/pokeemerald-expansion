mapscripts IlhadeTestes_MapScripts {}

const AFFINE = 0
const ALPHABLEND = 1

script PortaTrancada {
    lock
    msgbox (format("Esta porta está trancada. Se você viu isso, o teste é um sucesso!"))
    release
    end
}

// Apesar deste script estar neste mapa em específico, ele deveria ser um Commom_eventScript
// que seria chamado sempre que o jogador pisasse em um save point. Deixei aqui só para testar
script SavePoint {
    lock
    fadescreencustom (FADE_TO_CUSTOM, -8, 13, 0, 31) // modo, velocidade (menor é + rápido), r, g, b
    fadescreencustom (FADE_FROM_CUSTOM, 3, 13, 0, 31) // modo, velocidade (menor é + rápido), r, g, b
    special (HealPlayerParty)
    msgbox ("Você e seus pokémon se sentem\nrevigorados.")
    call (Common_EventScript_SaveGame)
    release
    end
}

script Anim {
    lock
    special (SpawnCameraObject)
    applymovement (LOCALID_CAMERA, moves(
        walk_up
    ))
    waitmovement (LOCALID_CAMERA)
    clearflag (FLAG_HIDE_BIRTH_ISLAND_DEOXYS_TRIANGLE)
    addobject (LOCALID_TRIANGLE)
    efeitografico(LOCALID_TRIANGLE, AFFINE, 0)
    efeitografico(LOCALID_TRIANGLE, ALPHABLEND, 0)
    delay (100)
    clearflag (FLAG_HIDE_DEOXYS)
    addobject (LOCALID_DEOXYS)
    efeitografico(LOCALID_DEOXYS, AFFINE, 2)
    setobjectsubpriority (LOCALID_DEOXYS, MAP_ILHADE_TESTES, 0) // controla o posicionamento dos sprites
    delay(126)
    applymovement (LOCALID_DEOXYS, moves(
        levitate
    ))
    waitmovement (LOCALID_DEOXYS)
    removeefeitografico(LOCALID_DEOXYS, AFFINE) // por algum motivo, é preciso remover a animação antes de applymovement de novo
    msgbox("Hello!")
    applymovement (LOCALID_DEOXYS, moves(
        stop_levitate
    ))
    waitmovement (LOCALID_DEOXYS)
    efeitografico(LOCALID_DEOXYS, AFFINE, 3)
    delay (126)
    removeefeitografico(LOCALID_DEOXYS, AFFINE)
    removeobject(LOCALID_DEOXYS)
    setflag(FLAG_HIDE_DEOXYS)
    efeitografico(LOCALID_TRIANGLE, AFFINE, 1)
    delay (108)
    removeefeitografico(LOCALID_TRIANGLE, AFFINE)
    removeefeitografico(LOCALID_TRIANGLE, ALPHABLEND)
    removeobject (LOCALID_TRIANGLE)
    setflag (FLAG_HIDE_BIRTH_ISLAND_DEOXYS_TRIANGLE)
    applymovement (LOCALID_CAMERA, moves(
        walk_down
    ))
    waitmovement (LOCALID_CAMERA)
    special (RemoveCameraObject)
    release
    end
}
